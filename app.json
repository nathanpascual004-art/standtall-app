{
  "expo": {
    "name": "StandTall",
    "slug": "StandTall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "standtall",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0d13",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0d13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "StandTall utilise tes photos pour analyser ta posture de profil.",
          "cameraPermission": "StandTall utilise l'appareil photo pour prendre une photo de profil et analyser ta posture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0d13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
